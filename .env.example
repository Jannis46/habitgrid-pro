# --- Verkauf -----------------------------------------------------------------
# Stripe-Zahlungslink (Dashboard > Zahlungslinks). Bewusst ein Payment Link statt einer
# Checkout-Session: kein Backend nötig, keine laufenden Serverkosten.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxxxxxxxxxxxx

# --- Authentifizierung -------------------------------------------------------
# Leer lassen = lokale Konten im Browser (funktioniert sofort, ohne Backend).
# Beide Werte gesetzt = Supabase übernimmt Registrierung, Login und Passwort-Reset.
# Der anon key ist öffentlich; der service_role key gehört NIEMALS hierher.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Hosting -----------------------------------------------------------------
# Basispfad der Anwendung. Leer lassen für Vercel, Netlify oder eine eigene Domain.
# Für GitHub Pages in einem Projekt-Repository den Repository-Namen eintragen,
# mit Schrägstrich vorn und hinten:  VITE_BASE=/habitgrid-pro/
# Der GitHub-Actions-Workflow setzt diesen Wert automatisch.
VITE_BASE=

# --- Website -----------------------------------------------------------------
VITE_SITE_URL=https://deine-domain.de
VITE_CONTACT_EMAIL=support@deine-domain.de

# --- Gutschein ---------------------------------------------------------------
# 100-%-Rabattcode für die Paywall. Leer lassen = Gutscheinfunktion deaktiviert.
# Der Wert landet beim Bauen im JavaScript-Bundle und ist dort lesbar — diese Variable
# hält ihn nur aus dem Quelltext-Repository heraus, sie macht ihn nicht geheim.
# Für einen wirklich begrenzbaren Code: Stripe-Gutscheine im Payment Link nutzen.
VITE_COUPON_CODE=

# --- Optionale Analyse -------------------------------------------------------
# Nur setzen, wenn du tatsächlich ein Analysewerkzeug einbindest. Ist dieser Wert
# gesetzt, erscheint der Cookie-Consent-Banner mit granularer Opt-in-Auswahl.
# Ohne Analysewerkzeug leer lassen — ein Banner ohne einwilligungspflichtige
# Dienste ist rechtlich überflüssig und kostet nur Conversion.
VITE_ANALYTICS_ID=demo

# --- Nur serverseitig (api/stripe-webhook.ts) --------------------------------
# Ohne VITE_-Präfix, damit sie nicht im Client-Bundle landen.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
